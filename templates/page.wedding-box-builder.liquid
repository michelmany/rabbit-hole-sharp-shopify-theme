{% comment %}
  Template for Wedding Box Builder
  This template creates a dedicated page for the wedding box builder wizard
{% endcomment %}

<div class="page-wedding-builder">
  <!-- Banner Section using main-page-banner with shape divider block -->
  {%- section 'main-page-banner' -%}

  <div class="wedding-builder-section py-8">
    <!-- Use the Wedding Form Wizard Section -->
    {% section 'wedding-form-wizard' %}

    <!-- Include page content if any -->
    {{ content_for_layout }}
  </div>
</div>

<style>
  .page-wedding-builder {
    min-height: 100vh;
  }

  .page-header {
    background: linear-gradient(135deg, #fdf2f8 0%, #faf5ff 100%);
  }

  .container {
    max-width: 1200px;
  }

  .info-card {
    padding: 2rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease-in-out;
  }

  .info-card:hover {
    transform: translateY(-4px);
  }

  @media (max-width: 768px) {
    .page-header {
      padding: 3rem 0;
    }

    .page-header h1 {
      font-size: 2.5rem;
    }
  }
</style>
