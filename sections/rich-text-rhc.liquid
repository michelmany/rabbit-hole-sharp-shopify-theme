            { "value": "rounded_heptagon", "label": "t:common.options.rounded_heptagon.label", "group": "t:common.groups.polygons" },
            { "value": "rounded_octagon", "label": "t:common.options.rounded_octagon.label", "group": "t:common.groups.polygons" },
            { "value": "rounded_nonagon", "label": "t:common.options.rounded_nonagon.label", "group": "t:common.groups.polygons" },
            { "value": "rounded_decagon", "label": "t:common.options.rounded_decagon.label", "group": "t:common.groups.polygons" },
