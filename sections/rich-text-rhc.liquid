            { "value": "scalloped_circle_6", "label": "t:common.options.scalloped_circle_6.label", "group": "t:common.groups.scalloped_circles" },
            { "value": "parallelogram", "label": "t:common.options.parallelogram.label", "group": "t:common.groups.square" },
