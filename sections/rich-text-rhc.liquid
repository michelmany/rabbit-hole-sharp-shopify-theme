<style>
  .rich-text-rhc-section .rabbit-hole-container {
    margin-top: 6rem;
  }
  @media (min-width: 768px) {
    .rich-text-rhc-section .section-content {
      padding-top: 230px !important;
      padding-bottom: 120px;
    }
    .rich-text-rhc-section .rabbit-hole-container {
      margin-top: 1rem;
    }
  }
</style>

{% if section.settings.bg_image_desktop != blank or section.settings.bg_image_mobile != blank %}
  <style>
    .rich-text-rhc-section{
      background-repeat: no-repeat;
      background-position: {{ section.settings.bg_position }};
      background-size: {{ section.settings.bg_size }};
    }
    @media (min-width: 768px){
      .rich-text-rhc-section{
        {% if section.settings.bg_image_desktop != blank %}
          background-image: url({{ section.settings.bg_image_desktop | image_url: width: 2880 }});
        {% endif %}
      }
    }
    @media (max-width: 767px){
      .rich-text-rhc-section{
        {% if section.settings.bg_image_mobile != blank %}
          background-image: url({{ section.settings.bg_image_mobile | image_url: width: 1200 }});
        {% elsif section.settings.bg_image_desktop != blank %}
          background-image: url({{ section.settings.bg_image_desktop | image_url: width: 1200 }});
        {% endif %}
      }
    }
  </style>
{% endif %}

<section
  class="rich-text-rhc-section relative overflow-hidden bg-scheme-background text-scheme-text {% if section.settings.use_gradient_background %}bg-scheme-gradient{% endif %}"
  data-color-scheme="{{ section.settings.color_scheme }}"
>
  <div class="section-content px-section">
    <div class="mx-auto {% if section.settings.content_width_desktop == 'lg:w-1/3' %}lg:w-1/3{% elsif section.settings.content_width_desktop == 'lg:w-1/2' %}lg:w-1/2{% elsif section.settings.content_width_desktop == 'lg:w-2/3' %}lg:w-2/3{% elsif section.settings.content_width_desktop == 'full' %}w-full{% endif %} {% if section.settings.display_on_card %}card{% endif %}">
      <div class="{% if section.settings.display_on_card %}card__surface p-5 lg:p-10{% endif %} relative z-shape-divider mx-auto text-center">
        <div class="hero-layout-container">
          {%- if section.settings.title != '' -%}
            <div class="rabbit-hole-container">
              <h1 class="feature-text inline-heading-rte font-heading heading-style break-words text-scale-n0 lg:text-scale-n0">
                <span class="rabbit-hole-title">
                  <span class="title-line rabbit" style="color: {{ section.settings.rabbit_color }};">{{- section.settings.rabbit_text -}}</span>
                  <span class="title-line hole" style="color: {{ section.settings.hole_color }};">{{- section.settings.hole_text -}}</span>
                  <span class="title-line cakes" style="color: {{ section.settings.cakes_color }};">{{- section.settings.cakes_text -}}</span>
                </span>
              </h1>
            </div>
          {%- endif -%}

          {%- if section.settings.button_link != blank and section.settings.button_label != '' -%}
            <a href="{{ section.settings.button_link }}" class="shop-now-btn"><span class="push-btn__surface">{{- section.settings.button_label -}}</span></a>
          {%- endif -%}

          {%- if section.settings.lovedby_text != blank -%}
            <div class="brand-text-wrapper">
              <div class="brand-text-logos">
                <span style="color: {{ section.settings.lovedby_text_color }};">{{- section.settings.lovedby_text -}}</span>
                {% if section.settings.logo_apple != blank -%}
                  <a href="{{ section.settings.logo_apple_link | default: '#' }}" target="_blank"><img src="{{ section.settings.logo_apple | image_url }}" alt="Apple"></a>
                {%- endif %}
                {% if section.settings.logo_three != blank -%}
                  <a href="{{ section.settings.logo_three_link | default: '#' }}" target="_blank"><img src="{{ section.settings.logo_three | image_url }}" alt="3"></a>
                {%- endif %}
                {% if section.settings.logo_sse != blank -%}
                  <a href="{{ section.settings.logo_sse_link | default: '#' }}" target="_blank"><img src="{{ section.settings.logo_sse | image_url }}" alt="SSE"></a>
                {%- endif %}
              </div>
            </div>
          {%- endif -%}
        </div>

        <div class="font-main {% if section.settings.title != '' %}mt-5{% endif %} rte mx-auto leading-snug">
          {{ section.settings.rich_text }}
        </div>
      </div>
    </div>
  </div>

  {%- liquid
    assign stickers = section.blocks | where: 'type', 'sticker'
    assign shape_dividers = section.blocks | where: 'type', 'shape_divider'
    for sticker in stickers
      render 'block-sticker', block: sticker
    endfor
    for shape_divider in shape_dividers
      render 'block-shape-divider', block: shape_divider
    endfor
  -%}
</section>

{% schema %}
