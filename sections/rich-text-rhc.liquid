            { "value": "star_4", "label": "t:common.options.star_4.label", "group": "t:common.groups.stars" },
            { "value": "star_5", "label": "t:common.options.star_5.label", "group": "t:common.groups.stars" },
            { "value": "star_6", "label": "t:common.options.star_6.label", "group": "t:common.groups.stars" },
            { "value": "scalloped_circle_1", "label": "t:common.options.scalloped_circle_1.label", "group": "t:common.groups.scalloped_circles" },
            { "value": "scalloped_circle_2", "label": "t:common.options.scalloped_circle_2.label", "group": "t:common.groups.scalloped_circles" },
