{% schema %}
{
  "name": "Team Members",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "member",
      "name": "Team Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Members"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .team-members-headline {
    color: #3b6d82;
  }
  .team-members-name {
    font-family: var(--heading-font-stack);
  }
  @media (max-width: 560px) {
    .team-members-headline {
      font-size: 34px !important;
    }
    .team-members-section.py-section-vertical-spacing {
      padding-top: 60px !important;
      padding-bottom: 60px !important;
    }
  }
{% endstylesheet %}

<section class="team-members-section section-content mx-auto max-w-site px-section relative overflow-hidden bg-scheme-background text-scheme-text overflow-hidden py-section-vertical-spacing">

    <h2 class="team-members-headline text-left font-heading heading-standard heading-style break-words">
      Meet Our Team
    </h2>

    <div class="team-members-rhc-grid grid grid-cols-1 gap-10 lg:grid-cols-3 section-content-top-margin">
      {% for block in section.blocks %}
        <div class="team-member">
          {%- if block.settings.photo != blank -%}
            {%- render 'media-image', media: block.settings.photo -%}
          {%- else -%}
            {%- render 'media-image-placeholder' -%}
          {%- endif -%}

          {% if block.settings.name != '' %}
            <h3 class="team-members-name rte mt-5 text-left">
              {{ block.settings.name }}
            </h3>
          {%- endif -%}
        </div>
      {% endfor %}
    </div>

</section>
