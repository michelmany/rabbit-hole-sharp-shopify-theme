<div class="splide__arrows absolute inset-0 flex items-center justify-between z-10 pointer-events-none">
  <button class="splide__arrow splide__arrow--prev push-btn pointer-events-auto">
    <span class="sr-only">{{ 'sections.slideshow.previous_slide' | t }}</span>
    <span class="push-btn__surface p-2 align-bottom">
      <span class="block h-5 w-5">{% render 'icon-previous' %}</span>
    </span>
  </button>

  {% if autoplay %}
    <button
      class="splide__toggle push-btn pointer-events-auto"
      type="button"
      aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
      data-play="{{ 'sections.slideshow.rotate_slideshow' | t }}"
      data-pause="{{ 'sections.slideshow.pause_slideshow' | t }}"
    >
      <span class="push-btn__surface p-2 align-bottom">
        <span class="splide__toggle__pause">
          <span class="block h-5 w-5">{% render 'icon-pause' %}</span>
        </span>
        <span class="splide__toggle__play">
          <span class="block h-5 w-5">{% render 'icon-play' %}</span>
        </span>
      </span>
    </button>
  {% endif %}

  <button class="splide__arrow splide__arrow--next push-btn pointer-events-auto">
    <span class="sr-only">{{ 'sections.slideshow.next_slide' | t }}</span>
    <span class="push-btn__surface p-2 align-bottom">
      <span class="block h-5 w-5">{% render 'icon-next' %}</span>
    </span>
  </button>
</div>
